{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://hospital-saas-backend-in7l.onrender.com/api/:match*"
    },
    {
      "source": "/",
      "destination": "/frontend/dist/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/dist/$1"
    }
  ]
}
